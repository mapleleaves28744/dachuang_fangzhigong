    {
      "id": "qb-ai-264d051c64ef",
      "concept": "导数",
      "difficulty": "medium",
      "question_type": "single_choice",
      "question": "函数 $ f(x) = x^2 \\ln x $（定义域 $ x > 0 $）的导数 $ f'(x) $ 为：",
      "options": [
        "A. $ 2x \\ln x + x $",
        "B. $ 2x \\ln x - x $",
        "C. $ 2x \\ln x + \\frac{x^2}{x} $",
        "D. $ 2x \\ln x + \\frac{1}{x} $"
      ],
      "answer": "A",
      "analysis": "使用乘积法则：$ (uv)' = u'v + uv' $，其中 $ u = x^2 $，$ v = \\ln x $，得 $ u' = 2x $，$ v' = \\frac{1}{x} $，故 $ f'(x) = 2x \\ln x + x^2 \\cdot \\frac{1}{x} = 2x \\ln x + x $。",
      "created_at": "2026-03-30T16:29:42.959129",
      "created_by": "official_ai",
      "is_public": true,
      "bank_source": "official_ai"
    },
    {
      "id": "qb-ai-a96ab9cd2e2d",
      "concept": "导数",
      "difficulty": "medium",
      "question_type": "short_answer",
      "question": "已知函数 $ g(x) = \\sin(3x + 1) $，求其在 $ x = 0 $ 处的导数值。",
      "options": [],
      "answer": "3\\cos(1)",
      "analysis": "由链式法则，$ g'(x) = \\cos(3x + 1) \\cdot 3 = 3\\cos(3x + 1) $，代入 $ x = 0 $ 得 $ g'(0) = 3\\cos(1) $。",
      "created_at": "2026-03-30T16:29:42.959163",
      "created_by": "official_ai",
      "is_public": true,
      "bank_source": "official_ai"
    },
    {
      "id": "qb-ai-64e2ffb2f48a",
      "concept": "导数",
      "difficulty": "medium",
      "question_type": "single_choice",
      "question": "若函数 $ h(x) = \\frac{e^x}{x} $（$ x \\neq 0 $），则其导数 $ h'(x) $ 等于：",
      "options": [
        "A. $ \\frac{e^x(x - 1)}{x^2} $",
        "B. $ \\frac{e^x(1 - x)}{x^2} $",
        "C. $ \\frac{e^x}{x^2} $",
        "D. $ \\frac{e^x(x + 1)}{x^2} $"
      ],
      "answer": "A",
      "analysis": "使用商法则：$ \\left( \\frac{u}{v} \\right)' = \\frac{u'v - uv'}{v^2} $，其中 $ u = e^x $，$ v = x $，得 $ u' = e^x $，$ v' = 1 $，故 $ h'(x) = \\frac{e^x \\cdot x - e^x \\cdot 1}{x^2} = \\frac{e^x(x - 1)}{x^2} $。",
      "created_at": "2026-03-30T16:29:42.959183",
      "created_by": "official_ai",
      "is_public": true,
      "bank_source": "official_ai"
    },
