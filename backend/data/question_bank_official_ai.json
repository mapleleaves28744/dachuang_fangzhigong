    {
      "id": "qb-ai-9ce4478dcb4e",
      "concept": "导数",
      "difficulty": "medium",
      "question_type": "single_choice",
      "question": "设函数 $ f(x) = x^2 e^x $，则 $ f'(1) $ 的值为？",
      "options": [
        "A. $ 3e $",
        "B. $ 2e $",
        "C. $ e $",
        "D. $ 4e $"
      ],
      "answer": "A",
      "analysis": "使用乘积法则：$ f'(x) = 2x e^x + x^2 e^x = e^x (2x + x^2) $，代入 $ x = 1 $ 得 $ f'(1) = e(2 + 1) = 3e $。",
      "created_at": "2026-03-30T20:46:33.377989",
      "created_by": "official_ai",
      "is_public": true,
      "bank_source": "official_ai"
    },
